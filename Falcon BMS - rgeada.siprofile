    {
      "ContainerType": "CustomEffectContainer",
      "IsEnabled": true,
      "Gain": 91.0,
      "Description": "Roll Calc",
      "FrontLeftFormula": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "if ($prop(\"FalconBMS.Utility.stopEffects\")){\r\n\treturn 0\r\n}\r\n\r\n\r\n\r\ntimes.push(Date.now())\r\ntimes = times.slice(1)\r\n\r\nroll = $prop(\"FalconBMS.flightData.roll\")\r\nrolls.push(roll)\r\nrolls = rolls.slice(1)\r\n\r\n\r\nrolling = 0\r\nfor (i=0; i<n-1; i++){\r\n\tdeltaT = (times[i+1]-times[i])/1000\r\n\tif (deltaT != 0){\r\n\t\trolling += (rolls[i+1]-rolls[i])/deltaT\r\n\t}\t\r\n}\r\n\r\nreturn (rolling/n)*50 + 50 \r\n\r\n",
        "PreExpression": "n = 3\r\ntimes = Array(n).fill(Date.now())\r\nrolls = Array(n).fill($prop(\"FalconBMS.flightData.roll\"))"
      },
      "FrontRightFormula": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "if ($prop(\"FalconBMS.Utility.stopEffects\")){\r\n\treturn 0\r\n}\r\n\r\n\r\n\r\ntimes.push(Date.now())\r\ntimes = times.slice(1)\r\n\r\nroll = $prop('JoystickPlugin.WINWING_Orion_Joystick_Base_2_+_JGRIP-F16_X')/65535\r\nrolls.push(roll)\r\nrolls = rolls.slice(1)\r\n\r\n\r\nrolling = 0\r\nfor (i=0; i<n-1; i++){\r\n\tdeltaT = (times[i+1]-times[i])/1000\r\n\tif (deltaT != 0){\r\n\t\trolling += (rolls[i+1]-rolls[i])/deltaT\r\n\t}\t\r\n}\r\n\r\nreturn (rolling/n)*50 + 50 \r\n\r\n",
        "PreExpression": "n = 15\r\ntimes = Array(n).fill(Date.now())\r\nrolls = Array(n).fill($prop('JoystickPlugin.WINWING_Orion_Joystick_Base_2_+_JGRIP-F16_X'))"
      },
