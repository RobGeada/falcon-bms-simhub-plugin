    {
      "ContainerType": "CustomEffectContainer",
      "IsEnabled": true,
      "Gain": 20.222222222222058,
      "Description": "Gs",
      "FrontLeftFormula": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "if ($prop(\"FalconBMS.Utility.stopEffects\")){\r\n\treturn 0\r\n}\r\n\r\n\r\ngs = $prop(\"FalconBMS.flightData.gs\")\r\ngsFromOne = Math.abs(gs - 1) ** 2\r\n\r\nbump = Math.random() > .5 \r\n\r\nreturn bump*(gsFromOne*100/64)"
      },
      "FrontRightFormula": {
        "Expression": ""
