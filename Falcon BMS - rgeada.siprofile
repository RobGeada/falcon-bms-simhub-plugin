        "Expression": "if ($prop(\"FalconBMS.Utility.stopEffects\")){\r\n\treturn 0\r\n}\r\n\r\nspeed = Math.min(1, $prop('FalconBMS.flightData.kias') / 50)\r\nbumpIntensity = $prop(\"FalconBMS.flightData.bumpIntensity\") * 100 * speed \r\nbump = Math.random() < .5\r\n\r\nreturn bump*bumpIntensity"
