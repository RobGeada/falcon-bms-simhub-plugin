      "FrontLeftFrequencyFormula": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "gear = $prop(\"FalconBMS.flightData.LeftGearPos\")\r\nleft = $prop(\"FalconBMS.lights3.LeftGearDown\")\r\n\r\nfreq = 50 + (1- gear) * 20\r\n\r\nif (gear > 0 && left != 1){\r\n\treturn freq\r\n} else {\r\n\treturn 55\r\n}"
      },
      "FrontRightFrequencyFormula": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "gear = $prop(\"FalconBMS.flightData.RightGearPos\")\r\nright = $prop(\"FalconBMS.lights3.RightGearDown\")\r\n\r\nfreq = 50 + (1- gear) * 20\r\n\r\nif (gear > 0 && right != 1){\r\n\treturn freq\r\n} else {\r\n\treturn 55\r\n}"
      },
